# 打包忽略清单：vsix 只需 dist/ 产物、resources/icon.svg 与清单类文件
# 源码与开发工具链（编译期使用，运行时不读）
src/**
dev/**
docs/**
.codebuddy/**
.vscode/**
vitest.config.mts

# 静态资源源码：shadcn 组件与模型图标均经 Vite 打包进 dist/webview，随包只需 icon.svg
resources/shadcn/**
resources/models/**

# 提示词资料：仓库内 resources/prompt 只是开发调试用的一份词库（把 zhai.prompt.rootPath 指过来即可直读），
# 生产环境读用户配置的词库目录，其体量与私有内容都不适合随包
resources/prompt/**

# 根目录依赖：pnpm 的符号链接布局无法被 vsce 的 npm list 检测处理，故打包时用 --no-dependencies。
# 需要随包分发的运行时依赖由 dev/scripts/bundle-native.mjs 单独装到 dist/node_modules/ 下，
# 因此这里只锚定根目录的 node_modules，放行 dist 内的依赖。
/node_modules/**

# 构建与工具配置（编译期使用，运行时不读）
vite.config.mjs
tsconfig.json
eslint.config.mjs
components.json
pnpm-lock.yaml
pnpm-workspace.yaml

# 版本控制与编辑器配置
.gitignore
.editorconfig
.prettierrc*
.prettierignore

# 开发过程产物
*.vsix
**/*.log
**/*.map
**/*.tsbuildinfo

# npm 在 dist 生成依赖目录时附带的锁文件
dist/package-lock.json
**/.package-lock.json

# dist 内的原生模块：运行时只需要 lib/ 与 prebuilds/，源码与构建脚本不随包
dist/node_modules/**/src/**
dist/node_modules/**/deps/**
dist/node_modules/**/*.gyp
dist/node_modules/**/*.md
