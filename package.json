{
    "name": "zhai-vscode",
    "displayName": "Zhai 宅桌面",
    "description": "面向「写小说 + 写代码」的 VSCode 插件：Markdown 主存储 + SQLite 缓存索引，提供 AI 辅助、全文检索、写作管理与内容发布能力",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "publisher": "zhai",
    "repository": {
        "type": "git",
        "url": "https://github.com/baiwanyi/zhai.vscode.git"
    },
    "homepage": "https://github.com/baiwanyi/zhai.vscode#readme",
    "bugs": {
        "url": "https://github.com/baiwanyi/zhai.vscode/issues"
    },
    "keywords": [
        "markdown",
        "notes",
        "writing",
        "novel",
        "ai",
        "deepseek",
        "sqlite",
        "full-text-search"
    ],
    "engines": {
        "vscode": "^1.137.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "compile": "pnpm run typecheck && node esbuild.mjs && pnpm run webview:build",
        "watch": "node esbuild.mjs --watch",
        "watch:all": "concurrently -n host,web,ts -c blue,green,yellow \"node esbuild.mjs --watch\" \"vite build --watch\" \"tsc --noEmit --watch\"",
        "webview:build": "vite build",
        "webview:dev": "vite build --watch",
        "webview:serve": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:ui": "prettier --write src/components/ui src/hooks",
        "package": "pnpm run compile && node bundle-native.mjs && vsce package --no-dependencies"
    },
    "contributes": {
        "commands": [
            {
                "command": "zhai.openDashboard",
                "title": "打开仪表盘",
                "category": "Zhai"
            },
            {
                "command": "zhai.openAiChat",
                "title": "打开 AI 对话",
                "category": "Zhai"
            },
            {
                "command": "zhai.rebuildIndex",
                "title": "重建索引",
                "category": "Zhai"
            },
            {
                "command": "zhai.showIndexStatus",
                "title": "索引状态",
                "category": "Zhai"
            },
            {
                "command": "zhai.clearIndex",
                "title": "清空索引缓存",
                "category": "Zhai"
            },
            {
                "command": "zhai.ai.setApiKey",
                "title": "设置 DeepSeek API Key",
                "category": "Zhai"
            },
            {
                "command": "zhai.ai.clearApiKey",
                "title": "清除 DeepSeek API Key",
                "category": "Zhai"
            },
            {
                "command": "zhai.openSettings",
                "title": "打开插件设置",
                "category": "Zhai"
            },
            {
                "command": "zhai.exportDiagnostics",
                "title": "导出诊断信息",
                "category": "Zhai"
            }
        ],
        "keybindings": [
            {
                "command": "zhai.openDashboard",
                "key": "ctrl+k",
                "when": "!inputBoxFocus"
            },
            {
                "command": "zhai.openAiChat",
                "key": "ctrl+shift+l",
                "when": "!inputBoxFocus"
            }
        ],
        "configuration": {
            "title": "Zhai 宅桌面",
            "properties": {
                "zhai.storage.rootPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "文档保存目录（空 = 工作区根），其下划分 `notes/`、`press/`、`reader/` 模块目录"
                },
                "zhai.index.exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**"
                    ],
                    "description": "索引排除的 glob 规则"
                },
                "zhai.index.debounceMs": {
                    "type": "number",
                    "default": 500,
                    "description": "增量索引防抖毫秒数"
                },
                "zhai.index.rebuildOnActivate": {
                    "type": "boolean",
                    "default": true,
                    "description": "激活时自检文件数与记录数，不一致时自动全量重建"
                },
                "zhai.search.limit": {
                    "type": "number",
                    "default": 50,
                    "description": "全局搜索单模块返回上限"
                },
                "zhai.ai.model": {
                    "type": "string",
                    "enum": [
                        "deepseek-chat",
                        "deepseek-reasoner"
                    ],
                    "default": "deepseek-chat",
                    "description": "默认 AI 模型"
                },
                "zhai.ai.temperature": {
                    "type": "number",
                    "default": 0.7,
                    "description": "默认温度（0.1 ~ 1.5）"
                },
                "zhai.ai.maxContextTokens": {
                    "type": "number",
                    "default": 4000,
                    "description": "前文注入 Token 上限"
                },
                "zhai.ai.dailyTokenBudget": {
                    "type": "number",
                    "default": 500000,
                    "description": "每日 Token 预算，达到阈值提示并阻断"
                },
                "zhai.telemetry.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "遥测开关（默认关闭，需显式开启）"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "zhai-sidebar",
                    "title": "Zhai 宅桌面",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "zhai-sidebar": [
                {
                    "type": "webview",
                    "id": "zhai.dashboard",
                    "name": "仪表盘",
                    "icon": "resources/icon.svg"
                },
                {
                    "type": "webview",
                    "id": "zhai.aiChat",
                    "name": "AI 对话",
                    "icon": "resources/icon.svg"
                }
            ]
        }
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "openai": "^7.15.0"
    },
    "devDependencies": {
        "@base-ui/react": "^1.8.0",
        "@eslint-react/eslint-plugin": "^5.19.0",
        "@eslint/js": "^10.0.1",
        "@shadcn/react": "^0.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/vscode": "^1.137.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "@vscode/vsce": "^3.9.2",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.3.0",
        "concurrently": "^10.0.5",
        "embla-carousel-react": "^8.6.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.45.0",
        "next-themes": "^0.4.6",
        "prettier": "^3.9.6",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.12.4",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "shadcn": "^4.21.0",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.70.0",
        "vaul": "^1.1.2",
        "vite": "^8.3.0"
    }
}
