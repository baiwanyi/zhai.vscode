{
    // 类型检查专用配置：产物由 esbuild（扩展宿主）与 Vite（webview）生成，tsc 不产出文件。
    // 取值依据 TypeScript 7 官方 --init 模板与破坏性变更清单：baseUrl、moduleResolution: node/classic、
    // target: es5 等在 7.0 已移除；module: preserve 隐含 moduleResolution: bundler 与 esModuleInterop。
    "compilerOptions": {
        // 环境与模块
        "module": "preserve",
        "target": "esnext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true,
        // 严格度：TS7 推荐项 + 项目既有约束
        // 未启用 noUnusedLocals / noUnusedParameters：占位阶段常保留待启用的草稿代码
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        // 路径别名：TS7 已移除 baseUrl，paths 相对本文件所在目录解析
        // @components 指向 shadcn 托管源码，@webview 指向前端业务层（src 下的页面、组件与工具），
        // @modules 指向宿主业务模块（src/modules 下的 press、ai、common 等），三者边界不可混用
        "paths": {
            "@components/*": ["./resources/shadcn/*"],
            "@modules/*": ["./src/modules/*"],
            "@resources/*": ["./resources/*"],
            "@shared/*": ["./src/shared/*"],
            "@webview/*": ["./src/*"]
        }
    },
    // resources/shadcn 是 @components 别名的落点，须纳入检查范围，否则组件源码不参与类型校验；
    // dev/test 是单测目录（不在 src 下），须单独纳入，否则测试文件不参与类型检查
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "dev/test/**/*.ts",
        "dev/test/**/*.tsx",
        "resources/**/*.ts",
        "resources/**/*.tsx",
        "dev/scripts/*.mjs",
        "vite.config.mjs",
        "vitest.config.mts"
    ]
}
