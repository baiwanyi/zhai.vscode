{
    // 类型检查专用配置：产物由 esbuild（扩展宿主）与 Vite（webview）生成，tsc 不产出文件。
    // 取值依据 TypeScript 7 官方 --init 模板与破坏性变更清单：baseUrl、moduleResolution: node/classic、
    // target: es5 等在 7.0 已移除；module: preserve 隐含 moduleResolution: bundler 与 esModuleInterop。
    "compilerOptions": {
        // 环境与模块
        "module": "preserve",
        "target": "esnext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true,
        // 严格度：TS7 推荐项 + 项目既有约束
        // 未启用 noUnusedLocals / noUnusedParameters：占位阶段常保留待启用的草稿代码
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        // 路径别名：TS7 已移除 baseUrl，paths 相对本文件所在目录解析
        "paths": {
            "@/*": ["./src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "esbuild.mjs", "vite.config.mjs"]
}
